{
  "name": "glassmark",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A local-first web archive with a Liquid Glass desktop and cross-browser capture extension.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "node scripts/check.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@playwright/test": "1.58.2",
    "@sparticuz/chromium": "143.0.4",
    "@tauri-apps/cli": "2.12.3",
    "esbuild": "^0.25.12",
    "lucide-static": "1.57.0",
    "prettier": "^3.6.2",
    "simple-icons": "16.35.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "hls.js": "1.6.15"
  }
}
