{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glassmark",
  "version": "0.8.16",
  "identifier": "com.glassmark.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glassmark",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "hiddenTitle": true,
        "decorations": false,
        "windowEffects": {
          "effects": [
            "sidebar",
            "acrylic"
          ],
          "state": "active",
          "radius": 20
        },
        "transparent": true,
        "backgroundColor": "#00000000",
        "noRedirectionBitmap": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src blob:; media-src 'self' blob: data:; connect-src 'self' blob: ipc: http://ipc.localhost http://127.0.0.1:47831; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Keep the web, beautifully.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "homepage": "https://github.com/kevinhuang001/bookmark-web",
    "linux": {
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libjavascriptcoregtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libayatana-appindicator3.so.1()(64bit)",
          "libxdo.so.3()(64bit)",
          "librsvg-2.so.2()(64bit)",
          "libssl.so.3()(64bit)",
          "libc.so.6(GLIBC_2.39)(64bit)",
          "ca-certificates"
        ],
        "files": {
          "/usr/share/licenses/glassmark/LICENSE": "../LICENSE"
        }
      }
    }
  }
}
